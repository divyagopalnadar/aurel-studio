# Data source (see lib/config.ts):
#   prisma (default) - SQLite database via Prisma, REST API, server-side admin
#   static           - catalog document data/catalog.json, static export for GitHub Pages
# The npm scripts dev:static / build:static set this for you.
NEXT_PUBLIC_DATA_SOURCE="prisma"

# Local SQLite database file (gitignored). Used by the prisma data source.
DATABASE_URL="file:./dev.db"
